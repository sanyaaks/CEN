# ==============================================================================
# MoSPI Airfare Index System (AirIndex India) — Environment Configuration Template
# ==============================================================================

# Application Environment: development | testing | production
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# Neon Cloud PostgreSQL Connection URL (Use SSL mode require)
# Example: postgresql://<user>:<password>@<neon-host>/neondb?sslmode=require
DATABASE_URL=postgresql://neondb_owner:password@ep-host.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# CORS Allowed Origins (Comma-separated list of trusted frontend origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://airindex.mospi.gov.in

# Scraper Settings
SCRAPER_USER_AGENT=AirIndexIndiaBot/1.0 (+https://airindex.mospi.gov.in/bot; contact: airindex@mospi.gov.in)
SCRAPER_RATE_LIMIT_PER_MINUTE=20
SCRAPER_REQUEST_TIMEOUT=15
SCRAPER_MAX_RETRIES=3
SCRAPER_BACKOFF_FACTOR=1.5
SCRAPER_SCHEDULE_INTERVAL=3600
SCRAPER_ENABLED=true

# Next.js Frontend Configuration (in frontend/.env.local)
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
